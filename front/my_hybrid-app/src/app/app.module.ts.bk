// import 'angular';
import { NgModule, ProviderToken } from '@angular/core';
import { BrowserModule } from '@angular/platform-browser';
import { UpgradeModule } from '@angular/upgrade/static';
// // ** Para lazy loading **
// import { UpgradeModule, setAngularJSGlobal } from '@angular/upgrade/static';

// import { NuevoComsponenteComponent } from './components/nuevo-componente/nuevo-componente.component';
import { AppRoutingModule } from './app-routing.module';
import { AppComponent } from './app.component';
import { provideHttpClient, withInterceptorsFromDi } from '@angular/common/http';

// Módulos
import { FilesModule } from './components/files/files.module';

// var angular = require('angular');
declare var requirejs: any;

import { setAngularJSGlobal } from '@angular/upgrade/static';
// declare var angular: any;

export function needsAngularJsInjectableFactory($injector: any) {
  return $injector.get('needsAngularJsInjectable');
}

@NgModule({
  imports: [
    BrowserModule,
    UpgradeModule,
    FilesModule,
    AppRoutingModule
  ],
  declarations: [
    AppComponent
  ],
  providers: [
    {
      provide: 'needsAngularJsInjectable',
      useFactory: needsAngularJsInjectableFactory,
      deps: ['$injector'] // $injector is provided by UpgradeModule
    },
    provideHttpClient(withInterceptorsFromDi())
  ],
})
export class AppModule {
  constructor(private upgrade: UpgradeModule) { }
  ngDoBootstrap() {
    // this.upgrade.bootstrap(document.body, ['myApp']);
    // console.log(this.upgrade.injector.get('needsAngularJsInjectable'));

    requirejs(['angular', 'myApp'], (angular: any) => {
      setAngularJSGlobal(angular);
      // this.upgrade.bootstrap(document, ['AngularJsAppModule']);
      this.upgrade.bootstrap(document.body, ['myApp']);
    });
  

    //     setAngularJSGlobal(angular);
    //     this.upgrade.bootstrap(document, ['AngularJsAppModule']);
    //   });
    // }


  }
}